{ "compilerOptions": { "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "strict": true, "noUncheckedIndexedAccess": true, "module": "esnext", "moduleResolution": "bundler",
  "jsx": "preserve", "incremental": true, "skipLibCheck": true, "noEmit": true, "isolatedModules": true, "resolveJsonModule": true, "allowJs": false, "esModuleInterop": true,
  "plugins": [{ "name": "next" }], "paths": { "@/*": ["./src/*"] } },
