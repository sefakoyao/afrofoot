# Member app (apps/app). Copy to .env.local for local work; on Vercel set these on the afrofoot-app project
# for both Production and Preview (type: Config, they are public by design).
# Supabase project URL, no trailing slash and no /rest/v1: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...), formerly called the anon key. Never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: this app's own URL for password-reset links (defaults to the request host)
APP_URL=
# Optional: public site linked from the "sign-in blocked" notice (defaults to https://www.afrofoot.club)
NEXT_PUBLIC_WEB_URL=
