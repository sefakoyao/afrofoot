NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TORNEOPAL_API_KEY=
# Public site (apps/web): secret Vercel Cron sends to /api/federation-sync (server-only, long random value)
CRON_SECRET=
PAYTRAIL_MERCHANT_ID=
PAYTRAIL_SECRET=
# Member app (apps/app): its own public URL, used in password-reset links (optional; defaults to the request host)
APP_URL=
# Public site, linked from the "sign-in blocked" notice so players can pay (optional; defaults to https://www.afrofoot.club)
NEXT_PUBLIC_WEB_URL=
# Public site (apps/web): its address for canonical links and the sitemap (optional; defaults to https://www.afrofoot.club)
NEXT_PUBLIC_SITE_URL=
# Public site: Google Search Console "HTML tag" code (optional; not needed when Search Console is verified by DNS)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
